    "patterns": [
      { "type": "comment", "pattern": "#.*" },
      { "type": "string", "start": "\"\"\"", "end": "\"\"\"" },
      { "type": "string", "start": "'''", "end": "'''" },
      { "type": "string", "start": "f\"\"\"", "end": "\"\"\"" },
      { "type": "string", "start": "f'''", "end": "'''" },
      { "type": "string", "pattern": "[fF]'[^'\\\\]*(\\\\.[^'\\\\]*)*'" },
      { "type": "string", "pattern": "[fF]\"[^\"\\\\]*(\\\\.[^\"\\\\]*)*\"" },
      { "type": "string", "pattern": "[bB]'[^'\\\\]*(\\\\.[^'\\\\]*)*'" },
      { "type": "string", "pattern": "[bB]\"[^\"\\\\]*(\\\\.[^\"\\\\]*)*\"" },
      { "type": "string", "pattern": "'[^'\\\\]*(\\\\.[^'\\\\]*)*'" },
      { "type": "string", "pattern": "\"[^\"\\\\]*(\\\\.[^\"\\\\]*)*\"" },
      { "type": "keyword", "pattern": "@[a-zA-Z_][a-zA-Z0-9_.]*" },
      { "type": "number", "pattern": "0x[0-9a-fA-F_]+" },
      { "type": "number", "pattern": "0b[01_]+" },
      { "type": "number", "pattern": "0o[0-7_]+" },
      { "type": "number", "pattern": "[0-9][0-9_]*\\.?[0-9_]*[eE]?[0-9_]*" },
      { "type": "operator", "pattern": "[+\\-=\\/\\*%<>!~|&^@\\.]" },
      { "type": "function", "pattern": "[a-zA-Z_][a-zA-Z0-9_]*(?=\\()" },
      { "type": "symbol", "pattern": "[a-zA-Z_][a-zA-Z0-9_]*" }
    ]
